<Window x:Class="TimetablePlanner.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Timetable Planner"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        MinWidth="1024"
        MinHeight="600"
        Background="#0F172A">
    <Window.Resources>
        <!-- Gépes / érintésbarát: nagyobb célterület, jó kontraszt -->
        <Style x:Key="KioskTopBarButton" TargetType="Button">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="KioskAccentButton" TargetType="Button" BasedOn="{StaticResource KioskTopBarButton}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Felső sáv: gépes felület — elkülönített, minden kötelező gomb -->
        <Border Grid.Row="0"
                Background="#1E293B"
                BorderBrush="#2563EB"
                BorderThickness="0,0,0,3"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Vertical"
                            VerticalAlignment="Center"
                            Margin="0,0,16,0">
                    <TextBlock Text="Timetable Planner"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#F8FAFC"/>
                    <TextBlock Text="Órarend"
                               FontSize="12"
                               Foreground="#94A3B8"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <WrapPanel Grid.Column="1"
                           VerticalAlignment="Center"
                           Orientation="Horizontal">
                    <Button x:Name="BtnSettings"
                            Content="Beállítások"
                            Style="{StaticResource KioskTopBarButton}"
                            Click="BtnSettings_Click">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="SettingsContextMenu">
                                <MenuItem Header="Adatbázis újraépítése"
                                          Click="BtnRecreateDb_Click"/>
                                <Separator/>
                                <MenuItem x:Name="MenuChkValidate"
                                          Header="Futtatás előtt ellenőrzés"
                                          IsCheckable="True"
                                          IsChecked="True"/>
                                <MenuItem x:Name="MenuChkDiagnostics"
                                          Header="Diagnosztika mentése"
                                          IsCheckable="True"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="BtnLessons"
                            Content="Órák"
                            Style="{StaticResource KioskTopBarButton}"
                            Click="BtnLessons_Click"/>
                    <Button x:Name="BtnTeachers"
                            Content="Tanárok"
                            Style="{StaticResource KioskTopBarButton}"
                            Click="BtnTeachers_Click"/>
                    <Button x:Name="BtnRooms"
                            Content="Termek"
                            Style="{StaticResource KioskTopBarButton}"
                            Click="BtnRooms_Click"/>
                    <Button x:Name="BtnGenerate"
                            Content="Generálás"
                            Style="{StaticResource KioskAccentButton}"
                            Click="BtnGenerate_Click"/>
                    <Button x:Name="BtnImport"
                            Content="Import"
                            Style="{StaticResource KioskTopBarButton}"
                            Click="BtnImportSeed_Click"/>
                    <Button x:Name="BtnExport"
                            Content="Export"
                            Style="{StaticResource KioskTopBarButton}"
                            Click="BtnExport_Click"/>
                    <Button x:Name="BtnView"
                            Content="Nézet"
                            Style="{StaticResource KioskTopBarButton}"
                            Margin="0,0,0,0"
                            Click="BtnView_Click"/>
                </WrapPanel>

                <TextBlock x:Name="StatusText"
                           Grid.Column="2"
                           Text="Kész."
                           VerticalAlignment="Center"
                           TextAlignment="Right"
                           TextWrapping="Wrap"
                           MaxWidth="320"
                           Foreground="#CBD5E1"
                           FontSize="13"/>
            </Grid>
        </Border>

        <!-- Táblázat: a teljes maradék képernyő -->
        <Border Grid.Row="1"
                Background="#F1F5F9"
                Padding="8,8,8,8">
            <DataGrid x:Name="ScheduleGrid"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      SelectionUnit="Cell"
                      GridLinesVisibility="All"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      Background="White"
                      BorderBrush="#CBD5E1"
                      BorderThickness="1"
                      HorizontalGridLinesBrush="#E2E8F0"
                      VerticalGridLinesBrush="#E2E8F0"
                      FontSize="14"
                      ColumnHeaderHeight="44"
                      AlternatingRowBackground="#F8FAFC"
                      AutoGeneratingColumn="ScheduleGrid_AutoGeneratingColumn"
                      MouseDoubleClick="ScheduleGrid_MouseDoubleClick"/>
        </Border>
    </Grid>
</Window>
